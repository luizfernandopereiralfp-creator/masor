# Masor — variáveis de ambiente do APP (copie para .env e preencha)
# A chave da Anthropic NÃO fica aqui — ela vive só no Credential do n8n.

# Webhook do workflow n8n "Masor — Análise Fiscal de Produto (IA)"
MASOR_ANALISE_WEBHOOK_URL="https://n8n.ferpereira.com/webhook/masor-analise-fiscal"

# Token de assinatura app -> n8n (gere um aleatório forte; o MESMO valor
# deve estar em $env.MASOR_WEBHOOK_TOKEN no n8n).
MASOR_WEBHOOK_TOKEN="troque-por-um-token-aleatorio-forte"

# --- Supabase (Fase 4) ---
# Públicas (podem ir no client — VITE_* são expostas no build):
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-publishable-key"
# Servidor (mesmos valores públicos, sem VITE_):
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-publishable-key"
# SECRETO — só no servidor, nunca no client nem no chat:
SUPABASE_SERVICE_ROLE_KEY=""
